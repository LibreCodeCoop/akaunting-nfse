{
  "name": "@librecodecoop/akaunting-nfse-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright E2E and frontend tests for akaunting-nfse module",
  "scripts": {
    "test:frontend": "node --test frontend-tests/*.test.mjs",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:headed": "playwright test -c playwright.config.ts --headed",
    "test:e2e:debug": "playwright test -c playwright.config.ts --debug",
    "test:e2e:smoke": "playwright test -c playwright.config.ts --project=smoke",
    "test:e2e:full-ui": "playwright test -c playwright.config.ts --project=full-ui",
    "test:e2e:bulk": "playwright test -c playwright.config.ts --project=full-ui e2e/nfse-bulk-emission.spec.ts --retries=0",
    "test:e2e:live": "playwright test -c playwright.config.ts --project=live-fiscal"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
