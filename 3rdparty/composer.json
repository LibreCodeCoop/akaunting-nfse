{
    "name": "librecodeoop/akaunting-nfse-runtime",
    "description": "Scoped runtime dependencies for the Akaunting NFS-e module",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/LibreCodeCoop/nfse-php"
        }
    ],
    "require": {
        "php": "^8.2",
        "librecodeoop/nfse-php": "dev-main#1d095222fe4a9a3396929283cb48a00509ec8381"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
